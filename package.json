{
  "name": "nextjs-rts-portfolio-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "npx --no-install next typegen && npx --no-install tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test",
    "admin:password": "node scripts/set-admin-password.mjs",
    "db:backup": "node scripts/backup-db.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "axios": "1.21.1",
    "framer-motion": "14.14.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.16.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
