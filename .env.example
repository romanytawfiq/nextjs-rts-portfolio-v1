# Copy to .env.local and fill in. Never commit real secrets.
# Auth.js GitHub callback URL: <SITE_URL>/api/auth/callback/github

# Server-only Auth.js secret. Auth fails closed when this is missing or shorter
# than 32 characters. SESSION_SECRET is still accepted as a local migration
# alias, but use AUTH_SECRET in production.
AUTH_SECRET=
# SESSION_SECRET=

# Set to 1 on the VPS/Hostinger host so Auth.js trusts the forwarded host.
AUTH_TRUST_HOST=
# AUTH_URL defaults to SITE_URL below; set it only if Auth.js needs a different
# public origin.
# AUTH_URL=

# GitHub OAuth. Leave empty to disable the GitHub button. AUTH_GITHUB_ID and
# AUTH_GITHUB_SECRET are Auth.js names; GITHUB_CLIENT_ID/GITHUB_CLIENT_SECRET
# are accepted as migration aliases.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Stable numeric GitHub ID from the owner's account. GitHub sign-in stays locked while empty.
GITHUB_ADMIN_ID=

# Local password login is configured separately (never as plaintext in env):
#   npm run admin:password
# It writes a scrypt hash to admin_credentials in the active database.
# Run it again with the same exported SQLITE_PATH in production.

# Public account whose repositories can be listed (CV: romanytawfiq).
GITHUB_REPO_OWNER=romanytawfiq

# Optional. Without a token, public repo sync is limited to GitHub's anonymous
# rate limit (60 requests/hour). Use a read-only token with NO repo scope.
GITHUB_TOKEN=

# Absolute site origin used for OAuth callbacks and canonical URLs.
SITE_URL=http://localhost:3000

# Set to 1 only behind a trusted reverse proxy that OVERWRITES X-Forwarded-For
# with the real client IP. Header presence alone is never trusted. Leave empty
# for local direct access, where a server-issued browser cookie is used instead.
TRUST_PROXY=
# Number of trusted rightmost X-Forwarded-For entries to ignore. Default 0.
TRUST_PROXY_HOPS=

# SQLite file. Local development only uses .data/portfolio.sqlite. On the VPS,
# point this to a durable path outside the deploy directory (for example
# /home/<user>/portfolio-data/portfolio.sqlite).
SQLITE_PATH=.data/portfolio.sqlite
